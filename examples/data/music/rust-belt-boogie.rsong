mixer:
  version: 1
  buses:
  - name: master
    volume: 0
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 30
        high-gain: 1
    - type: compressor
      id: glue
      params:
        threshold: -14
        ratio: 2.5
        attack: 0.02
        release: 0.25
        makeup: 1
    - type: limiter
      id: limit
      params:
        ceiling: -1
  - name: snare
    parent: master
    volume: -2
    sends:
    - target: fx
      level: -14
    effects:
    - type: compressor
      id: punch
      params:
        threshold: -18
        ratio: 3
        attack: 0.006
        release: 0.1
  - name: guitars
    parent: master
    volume: -3
    effects:
    - type: distortion
      id: amp
      params:
        mode: soft-clip
        drive: 18
        tone: 5000
        output: -9.9
        mix: 1
    - type: equalizer
      id: cab
      params:
        low-cut: 90
        mid1-freq: 900
        mid1-gain: 4
        mid1-q: 0.9
        high-cut: 6500
  - name: bass
    parent: master
    volume: -1
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 35
        mid1-freq: 800
        mid1-gain: 2
  - name: organ
    parent: master
    volume: -4
    sends:
    - target: fx
      level: -10
    effects:
    - type: distortion
      id: leslie
      params:
        mode: soft-clip
        drive: 6
        tone: 6000
        output: -3
        mix: 0.4
    - type: chorus
      id: rotor
  - name: lead
    parent: master
    volume: -1
    sends:
    - target: fx
      level: -10
    effects:
    - type: distortion
      id: amp
      params:
        mode: tanh
        drive: 22
        tone: 6500
        output: -12.1
        mix: 1
    - type: equalizer
      id: cab
      params:
        low-cut: 90
        mid1-freq: 1100
        mid1-gain: 4
        mid1-q: 0.9
        high-cut: 7500
    - type: echo
      id: delay
      params:
        delay: 0.3629
        feedback: 0.25
        dry: 1
        wet: 0.18
  - name: fx
    parent: master
    volume: -6
    effects:
    - type: reverb
      id: hall
      params:
        room-size: 0.6
        damping: 0.5
        wet: 1
        dry: 0
