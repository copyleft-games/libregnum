mixer:
  version: 1
  buses:
  - name: master
    volume: 0
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 30
        high-gain: 1
    - type: compressor
      id: glue
      params:
        threshold: -14
        ratio: 3
        attack: 0.02
        release: 0.25
        makeup: 1
    - type: limiter
      id: limit
      params:
        ceiling: -1
  - name: drums
    parent: master
    volume: -1
    sends:
    - target: fx
      level: -14
    effects:
    - type: compressor
      id: punch
      params:
        threshold: -18
        ratio: 4
        attack: 0.005
        release: 0.09
    - type: distortion
      id: heat
      params:
        mode: tanh
        drive: 3
        tone: 12000
        output: -1.5
        mix: 0.3
  - name: kick
    parent: drums
    volume: 0
    effects:
    - type: equalizer
      id: eq
      params:
        low-freq: 65
        low-gain: 2
        mid1-freq: 350
        mid1-gain: -4
        high-freq: 4000
        high-gain: 3
  - name: snare
    parent: drums
    volume: -4
    sends:
    - target: fx
      level: -10
  - name: toms
    parent: drums
    volume: -3
    sends:
    - target: fx
      level: -9
  - name: cymbals
    parent: drums
    volume: -10
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 400
  - name: guitars
    parent: master
    volume: -2
    effects:
    - type: distortion
      id: amp
      params:
        mode: tanh
        drive: 28
        tone: 5600
        output: -15.4
        mix: 1
    - type: equalizer
      id: cab
      params:
        low-cut: 90
        mid1-freq: 800
        mid1-gain: 3
        mid1-q: 0.9
        high-cut: 6500
  - name: bass
    parent: master
    volume: -3
    effects:
    - type: distortion
      id: grit
      params:
        mode: soft-clip
        drive: 8
        tone: 3000
        output: -4
        mix: 0.5
    - type: equalizer
      id: eq
      params:
        low-cut: 35
        mid1-freq: 700
        mid1-gain: 2
  - name: lead
    parent: master
    volume: -3
    sends:
    - target: fx
      level: -10
    effects:
    - type: distortion
      id: amp
      params:
        mode: tanh
        drive: 22
        tone: 7000
        output: -12.1
        mix: 1
    - type: equalizer
      id: cab
      params:
        low-cut: 90
        mid1-freq: 1200
        mid1-gain: 4
        mid1-q: 0.9
        high-cut: 8000
    - type: echo
      id: delay
      params:
        delay: 0.3
        feedback: 0.3
        dry: 1
        wet: 0.2
  - name: choir
    parent: master
    volume: 0
    sends:
    - target: fx
      level: -4
    effects:
    - type: stereo-widener
      id: wide
      params:
        width: 1.5
        bass-mono: 200
  - name: fx
    parent: master
    volume: -6
    effects:
    - type: reverb
      id: hall
      params:
        room-size: 0.8
        damping: 0.45
        wet: 1
        dry: 0
  ducking:
  - trigger: kick
    target: bass
    threshold: -30
    depth: -3
    attack: 0.003
    release: 0.06
