automation:
- target: bus.master.volume
  points:
  - 0 -20
  - 24 0
  - 248 0
  - 264 -40
mixer:
  version: 1
  buses:
  - name: master
    volume: 0
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 25
        high-gain: 1
    - type: compressor
      id: glue
      params:
        threshold: -16
        ratio: 2.5
        attack: 0.02
        release: 0.25
        makeup: 1
    - type: limiter
      id: limit
      params:
        ceiling: -1
  - name: drums
    parent: master
    volume: -2
    sends:
    - target: fx
      level: -5
    effects:
    - type: compressor
      id: punch
      params:
        threshold: -20
        ratio: 4
        attack: 0.01
        release: 0.2
  - name: guitars
    parent: master
    volume: -3
    sends:
    - target: fx
      level: -16
    effects:
    - type: distortion
      id: amp
      params:
        mode: hard-clip
        drive: 32
        tone: 3600
        output: -17.6
        mix: 1
    - type: equalizer
      id: cab
      params:
        low-cut: 60
        mid1-freq: 600
        mid1-gain: -2
        mid1-q: 0.9
        high-cut: 5000
  - name: bass
    parent: master
    volume: -3
    effects:
    - type: distortion
      id: fuzz
      params:
        mode: soft-clip
        drive: 12
        tone: 1800
        output: -6
        mix: 0.6
  - name: pad
    parent: master
    volume: -4
    sends:
    - target: fx
      level: -4
  - name: bell
    parent: master
    volume: -3
    sends:
    - target: fx
      level: -2
  - name: lead
    parent: master
    volume: -7
    sends:
    - target: fx
      level: -6
    effects:
    - type: distortion
      id: amp
      params:
        mode: tanh
        drive: 20
        tone: 6000
        output: -11
        mix: 1
    - type: equalizer
      id: cab
      params:
        low-cut: 90
        mid1-freq: 1000
        mid1-gain: 3
        mid1-q: 0.9
        high-cut: 7000
    - type: echo
      id: delay
      params:
        delay: 0.6818
        feedback: 0.45
        dry: 1
        wet: 0.3
  - name: fx
    parent: master
    volume: -4
    effects:
    - type: reverb
      id: hall
      params:
        room-size: 0.96
        damping: 0.4
        wet: 1
        dry: 0
