mixer:
  version: 1
  buses:
  - name: master
    volume: 0
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 25
        high-gain: 1
    - type: compressor
      id: glue
      params:
        threshold: -12
        ratio: 2
        attack: 0.02
        release: 0.25
        makeup: 1
    - type: limiter
      id: limit
      params:
        ceiling: -1
  - name: kick
    parent: master
    volume: -5
  - name: drums
    parent: master
    volume: -6
    sends:
    - target: gate-verb
      level: -6
    effects:
    - type: compressor
      id: punch
      params:
        threshold: -16
        ratio: 3
        attack: 0.006
        release: 0.1
  - name: gate-verb
    parent: master
    volume: -3
    effects:
    - type: reverb
      id: room
      params:
        room-size: 0.9
        damping: 0.3
        wet: 1
        dry: 0
    - type: gate
      params:
        threshold: -34
        attack: 0.001
        hold: 0.16
        release: 0.04
        range: -80
  - name: bass
    parent: master
    volume: -3
  - name: synths
    parent: master
    volume: 0
    effects:
    - type: stereo-widener
      id: wide
      params:
        width: 1.3
        bass-mono: 150
  - name: pad
    parent: synths
    volume: -5
    sends:
    - target: fx
      level: -8
  - name: lead
    parent: synths
    volume: -1
    sends:
    - target: fx
      level: -9
    effects:
    - type: echo
      id: delay
      params:
        delay: 0.3516
        feedback: 0.35
        dry: 1
        wet: 0.25
  - name: fx
    parent: master
    volume: -4
    effects:
    - type: reverb
      id: hall
      params:
        room-size: 0.85
        damping: 0.4
        wet: 1
        dry: 0
  ducking:
  - trigger: kick
    target: pad
    threshold: -30
    depth: -8
    attack: 0.003
    release: 0.15
  - trigger: kick
    target: bass
    threshold: -30
    depth: -6
    attack: 0.003
    release: 0.1
