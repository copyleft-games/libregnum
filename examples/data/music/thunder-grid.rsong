mixer:
  version: 1
  buses:
  - name: master
    volume: 0
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 25
        high-gain: 1
    - type: compressor
      id: glue
      params:
        threshold: -14
        ratio: 2.5
        attack: 0.02
        release: 0.25
        makeup: 1
    - type: limiter
      id: limit
      params:
        ceiling: -1
  - name: drums
    parent: master
    volume: -1
    effects:
    - type: compressor
      id: punch
      params:
        threshold: -16
        ratio: 3
        attack: 0.006
        release: 0.1
    - type: distortion
      id: heat
      params:
        mode: tanh
        drive: 5
        tone: 12000
        output: -2.5
        mix: 0.35
  - name: kick
    parent: drums
    volume: 0
    effects:
    - type: equalizer
      id: eq
      params:
        low-freq: 70
        low-gain: 3
  - name: snare
    parent: drums
    volume: -7
    sends:
    - target: gate-verb
      level: -4
  - name: toms
    parent: drums
    volume: -2
    sends:
    - target: fx
      level: -10
    - target: gate-verb
      level: -8
  - name: cymbals
    parent: drums
    volume: -9
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 350
  - name: gate-verb
    parent: master
    volume: -9
    effects:
    - type: reverb
      id: room
      params:
        room-size: 0.95
        damping: 0.3
        wet: 1
        dry: 0
    - type: gate
      params:
        threshold: -34
        attack: 0.001
        hold: 0.16
        release: 0.04
        range: -80
  - name: bass
    parent: master
    volume: -2
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 28
        mid1-freq: 260
        mid1-gain: -2.5
  - name: synths
    parent: master
    volume: 0
    effects:
    - type: stereo-widener
      id: wide
      params:
        width: 1.3
        bass-mono: 150
  - name: pad
    parent: synths
    volume: -4
    sends:
    - target: fx
      level: -8
    effects:
    - type: chorus
  - name: lead
    parent: synths
    volume: -1.5
    sends:
    - target: fx
      level: -9
    effects:
    - type: echo
      id: delay
      params:
        delay: 0.3814
        feedback: 0.35
        dry: 1
        wet: 0.25
  - name: fx
    parent: master
    volume: -4
    effects:
    - type: reverb
      id: hall
      params:
        room-size: 0.9
        damping: 0.35
        wet: 1
        dry: 0
  ducking:
  - trigger: kick
    target: pad
    threshold: -30
    depth: -7
    attack: 0.003
    release: 0.18
  - trigger: kick
    target: bass
    threshold: -30
    depth: -5
    attack: 0.003
    release: 0.12
