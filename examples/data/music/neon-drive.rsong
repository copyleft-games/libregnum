automation:
- target: bus.master.volume
  points:
  - 0 0
  - 268 0
  - 288 -40
mixer:
  version: 1
  buses:
  - name: master
    volume: 0
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 25
        high-gain: 1.5
    - type: compressor
      id: glue
      params:
        threshold: -12
        ratio: 2
        attack: 0.02
        release: 0.25
        makeup: 1
    - type: limiter
      id: limit
      params:
        ceiling: -1
  - name: kick
    parent: master
    volume: 0
  - name: drums
    parent: master
    volume: -3
    sends:
    - target: fx
      level: -16
    effects:
    - type: compressor
      id: punch
      params:
        threshold: -16
        ratio: 3
        attack: 0.006
        release: 0.1
  - name: bass
    parent: master
    volume: -2
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 28
        mid1-freq: 260
        mid1-gain: -2.5
  - name: synths
    parent: master
    volume: 0
    effects:
    - type: stereo-widener
      id: wide
      params:
        width: 1.3
        bass-mono: 150
  - name: pad
    parent: synths
    volume: -3
    sends:
    - target: fx
      level: -8
    effects:
    - type: chorus
  - name: lead
    parent: synths
    volume: -1.5
    sends:
    - target: fx
      level: -9
    effects:
    - type: echo
      id: delay
      params:
        delay: 0.41666666
        feedback: 0.38
        dry: 1
        wet: 0.28
  - name: fx
    parent: master
    volume: -4
    effects:
    - type: reverb
      id: hall
      params:
        room-size: 0.88
        damping: 0.35
        wet: 1
        dry: 0
  ducking:
  - trigger: kick
    target: pad
    threshold: -30
    depth: -7
    attack: 0.003
    release: 0.18
  - trigger: kick
    target: bass
    threshold: -30
    depth: -5
    attack: 0.002
    release: 0.12
