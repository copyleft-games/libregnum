mixer:
  version: 1
  buses:
  - name: master
    volume: 0
    effects:
    - type: equalizer
      id: eq
      params:
        low-cut: 25
        high-gain: 1
    - type: compressor
      id: glue
      params:
        threshold: -14
        ratio: 2.5
        attack: 0.02
        release: 0.25
        makeup: 1
    - type: limiter
      id: limit
      params:
        ceiling: -1
  - name: kick
    parent: master
    volume: 0
    effects:
    - type: distortion
      id: grit
      params:
        mode: tanh
        drive: 6
        tone: 9000
        output: -3
        mix: 0.5
  - name: drums
    parent: master
    volume: -3
    sends:
    - target: fx
      level: -18
    effects:
    - type: distortion
      id: crush
      params:
        mode: bitcrush
        bits: 10
        downsample: 2
        mix: 0.25
    - type: compressor
      id: punch
      params:
        threshold: -18
        ratio: 4
        attack: 0.004
        release: 0.09
  - name: bass
    parent: master
    volume: 3
    effects:
    - type: distortion
      id: fuzz
      params:
        mode: hard-clip
        drive: 10
        tone: 3500
        output: -6
        mix: 0.6
    - type: equalizer
      id: eq
      params:
        low-cut: 30
        mid1-freq: 400
        mid1-gain: -2
  - name: synths
    parent: master
    volume: 0
    effects:
    - type: stereo-widener
      id: wide
      params:
        width: 1.4
        bass-mono: 160
  - name: lead
    parent: synths
    volume: -2
    sends:
    - target: fx
      level: -10
    effects:
    - type: echo
      id: delay
      params:
        delay: 0.45
        feedback: 0.4
        dry: 1
        wet: 0.3
  - name: fx
    parent: master
    volume: -5
    effects:
    - type: reverb
      id: hall
      params:
        room-size: 0.8
        damping: 0.5
        wet: 1
        dry: 0
  ducking:
  - trigger: kick
    target: bass
    threshold: -30
    depth: -4
    attack: 0.003
    release: 0.1
  - trigger: kick
    target: synths
    threshold: -30
    depth: -4
    attack: 0.003
    release: 0.15
