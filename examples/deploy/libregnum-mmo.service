# Reference single-host deployment; install a built mmo-server and your own certificates.
[Unit]
Description=Libregnum MMO reference service
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=libregnum-mmo
UMask=0077
LoadCredential=tls-cert:/etc/libregnum-mmo/chain.pem
LoadCredential=tls-key:/etc/libregnum-mmo/key.pem
ExecStart=/usr/local/bin/mmo-server --database /var/lib/libregnum-mmo/world.db --certificate ${CREDENTIALS_DIRECTORY}/tls-cert --key ${CREDENTIALS_DIRECTORY}/tls-key --port 7777 --metrics-port 9090
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
