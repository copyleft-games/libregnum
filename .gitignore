# Build artifacts
build/
tests/build/
examples/build/

# Generated source files (from .in templates)
src/lrg-version.h
src/config.h

# Dependency build outputs (submodules have their own builds)
deps/graylib/build/
deps/yaml-glib/build/

# Compiled files (safety net for files outside build/)
*.o
*.a
*.so
*.so.*
*.gir
*.typelib

# g-ir-scanner temporary files
g-ir-cpp-*.c

# Editor/IDE files
*.swp
*.swo
*~
.vscode/
.idea/

# OS-specific
.DS_Store

# Tool directories
.claude/
.unlazy/

# clangd cache files for lsp
.cache/

# ignore mcp config
.mcp.json
tests/mutter.log
# generated by examples/pbr-showcase on first run
examples/data/pbr-showcase/models/knot.obj
examples/data/pbr-showcase/models/knot.obj.meta
# lrgeditor writes an asset .meta sidecar (GUID, import settings) next to
# every asset it sees; opening examples/data/* as a project must not
# leave them as untracked files (none of the examples ships one)
examples/data/**/*.meta
